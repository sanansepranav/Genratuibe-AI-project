# Server Port
PORT=3000

# MongoDB Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/interview-ai

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini Generative AI API Key
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key_here

# Frontend origin allowed to send credentialed API requests
FRONTEND_URL=http://localhost:5173

# Optional comma-separated list of additional frontend origins
# CORS_ORIGINS=https://your-frontend.example.com
