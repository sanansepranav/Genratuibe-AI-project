{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/interview/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/interview/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/interview/dist/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/interview/dist/index.html"
    }
  ]
}
